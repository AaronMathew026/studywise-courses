{
  "name": "studywise",
  "productName": "Studywise",
  "version": "1.0.0",
  "description": "Flashcards, notes and AI-powered Learn mode for macOS, powered by your local Claude Code.",
  "author": "Studywise",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cross-env AI_MOCK=1 ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env AI_MOCK=1 ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:e2e": "npm run build && cross-env AI_MOCK=1 playwright test",
    "ai:smoke": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/ai-smoke.ts",
    "ai:real-check": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/real-check.ts",
    "icons": "node scripts/make-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64 --x64",
    "dist:arm64": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.75.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
